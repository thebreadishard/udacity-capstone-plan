{
 "name": "v14_data_evals",
 "purpose": "v1.4 on the data: registration by name and six hold-out evals (design note 14)",
 "host": "laptop",
 "workdir": "probes/results_m1",
 "command": "python ../chain_runner.py probes/runs/v14_data_evals.json",
 "sources": [
  {
   "local": "probes/chain_runner.py"
  },
  {
   "local": "probes/v14_search.py"
  },
  {
   "local": "probes/promotion_read.py"
  },
  {
   "local": "modules/05_support_predictor/m05/rungC_train.py"
  }
 ],
 "progress": {
  "regex": "^=== \\(V14E\\) progress: |^\\(V14E\\) .* done ",
  "max_gap_minutes": 120,
  "start_regex": "^=== \\(V14E\\) starting: "
 },
 "marker_regex": "^=== \\(V14E\\) (armed|starting|resuming|RUN FAILED|run done)",
 "end_regex": "^=== \\(V14E\\) run done",
 "fail_regex": "^=== \\(V14E\\) RUN FAILED",
 "dry_run_args": "--dry-run",
 "resumable": true,
 "memory": {
  "peak_gb": 7.7,
  "basis": "chain 41's trainer peak (7.7 GB at n = 972-978, 19 Oct 2026); v1.4's pool \u2248 1,200"
 },
 "estimate": {
  "hours": 1.0,
  "basis": "six evals at the 254 s a selection eval took on 16 Nov 2026 (v14_seleval_smoke_win), and the registry's rebuild"
 }
}
