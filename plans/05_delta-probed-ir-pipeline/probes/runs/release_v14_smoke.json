{
 "_about": "TASKS 252's smoke of v1.4's release chain: the release training's command for 2 epochs and seed 0, then its in-sample read",
 "name": "RELSMOKE",
 "poll_s": 1800,
 "wait": [],
 "steps": [
  {
   "kind": "cmd",
   "label": "smoke: train release, 2 epochs, seed 0",
   "cwd": "modules/05_support_predictor",
   "log": "modules/05_support_predictor/out/v14/smoke_release_v14.log",
   "argv": [
    "{python}",
    "m05/rungC_train.py",
    "corpus/molecules",
    "out/v14/smoke_release_v14",
    "--sizes",
    "all",
    "--pool-layers",
    "A,A2,B,P3,P3c",
    "--epochs",
    "2",
    "--lr",
    "0.0003",
    "--use-analytic",
    "--aux-weight",
    "1.0",
    "--inner-val",
    "0.15",
    "--patience",
    "20",
    "--kring-weight",
    "0.3",
    "--kdiag-mode",
    "family",
    "--kdiag-weight",
    "0.1",
    "--save-model",
    "--holdout-twins",
    "drop-any-charge",
    "--network-kind",
    "release",
    "--aux",
    "both",
    "--head",
    "hybrid",
    "--sqm-scale",
    "--pair-features",
    "--hybrid-hidden",
    "256",
    "--pattern",
    "f",
    "--aggregation",
    "sum",
    "--seeds",
    "0"
   ]
  },
  {
   "kind": "cmd",
   "label": "smoke: in-sample read seed 0",
   "cwd": "modules/05_support_predictor",
   "log": "modules/05_support_predictor/out/v14/smoke_release_v14_insample_seed0.log",
   "argv": [
    "{python}",
    "../../probes/rungC_eval_saved.py",
    "out/v14/smoke_release_v14_model_n*_seed0.pt",
    "out/v14/smoke_release_v14_insample_seed0",
    "--use-analytic",
    "--threads",
    "8",
    "--allow-any-model",
    "--holdout-b-file",
    "corpus/holdout_b_frozen_2026-10-08.txt",
    "--eval-ids-file",
    "a8=out/holdout_a_clean_2026-10-30.txt",
    "--insample-read"
   ],
   "glob_args": true
  }
 ],
 "outputs": [
  "modules/05_support_predictor/out/v14/smoke_release_v14.json",
  "modules/05_support_predictor/out/v14/smoke_release_v14_insample_seed0.json"
 ]
}
