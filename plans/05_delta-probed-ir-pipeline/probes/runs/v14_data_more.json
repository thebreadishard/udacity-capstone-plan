   "log": "modules/05_support_predictor/out/v14/E7_rungC_v14s3more_c00_control.log",
   "argv": [
    "{python}",
    "m05/rungC_train.py",
    "corpus/molecules",
    "out/v14/E7_rungC_v14s3more_c00_control",
    "--use-analytic",
    "--pool-layers",
    "A,A2,B,P3,P3c",
    "--inner-val",
    "0.15",
    "--aggregation",
    "sum",
    "--head",
    "hybrid",
    "--aux",
    "both",
    "--kring-weight",
    "0.3",
    "--kdiag-weight",
    "0.1",
    "--kdiag-mode",
    "family",
    "--sqm-scale",
    "--pair-features",
    "--aux-weight",
    "1.0",
    "--epochs",
    "300",
    "--patience",
    "20",
    "--lr",
    "0.0003",
    "--hybrid-hidden",
    "256",
    "--pattern",
    "f",
    "--weight-decay",
    "0.0001",
    "--body-width",
    "64",
    "--body-blocks",
