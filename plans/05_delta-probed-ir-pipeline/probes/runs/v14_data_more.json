    "--add-candidates",
    "out/v14/E7_rungC_v14s3more_c00_control_model_n*_seed3.pt",
    "out/v14/E7_rungC_v14s3more_c00_control_model_n*_seed4.pt",
    "--chain",
    "v14 search",
    "--note",
    "v1.4 search (Design_2026-10-26_DeltaH_v1.4_Recipe_and_Search.md): a model of the search, not a version"
   ]
  },
  {
