   "label": "eval eval_data_seed3",
   "cwd": "modules/05_support_predictor",
   "log": "modules/05_support_predictor/out/v14/eval_data_seed3.log",
   "glob_args": true,
   "argv": [
    "{python}",
    "../../probes/rungC_eval_saved.py",
    "out/v14/E7_rungC_v14s3more_c00_control_model_n*_seed3.pt",
