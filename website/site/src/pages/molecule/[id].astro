---
// Molecule page (design §4.3): header, spectrum, depiction, status ladder, frequency tables, provenance.
// 10 Oct 2026 (TASKS 44–45, DESIGN_2026-10-10_Intensity_Chart.md §4a, §9): the page leads with the best spectrum it has — the anchor's (rung 4–5),
// else the cheap level's with band heights, else the cheap positions — so phones and portrait tablets see it in the first screen (it started
// 1,427 px down on a 375 px phone); on desktop it heads the right column. One DOM: the lead card is the first child of .cols, placed by grid on
// wide screens; the cards are components so no card is written twice.
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import AnchorSpectrumCard from '../../components/AnchorSpectrumCard.astro';
import CheapSpectrumCard from '../../components/CheapSpectrumCard.astro';
import FrequenciesCard from '../../components/FrequenciesCard.astro';
import Viewer3D from '../../components/Viewer3D.astro';
import catalog from '../../../../export/out/catalog.json';
import summary from '../../../../export/out/summary.json';
import { withBase } from '../../lib/base';
import { describeFlags } from '../../lib/flags';
import { mergeBands, sticksFrom } from '../../lib/bands';

export async function getStaticPaths() {
  return catalog.filter((r) => r.rung >= 1).map((r) => ({ params: { id: r.id }, props: { row: r } }));
}
const { row } = Astro.props;
const outDir = path.resolve('../export/out');
const mol = JSON.parse(fs.readFileSync(path.join(outDir, 'molecules', `${row.id}.json`), 'utf8'));
const svgPath = path.join(outDir, 'depictions', `${row.id}.svg`);
const svg = fs.existsSync(svgPath) ? fs.readFileSync(svgPath, 'utf8') : '';
const labels = ['Listed', 'Cheap level done', 'Correction predicted', 'Spectrum predicted', 'Anchored', 'Validated'];
const reached = (i) => i <= row.rung && !(i === 2 || i === 3);   // rungs 2–3 are reserved until the layer produces them
const vib = mol.frequencies_cm;
const heights = mol.intensities_km_mol?.b3lyp ?? null;
const rows = vib.b3lyp.vibrational.map((f, i) => ({ i: i + 1, b3lyp: f, wb97x: vib.wb97x.vibrational[i], shift: vib.wb97x.vibrational[i] - f, km: heights ? heights[i] : null }));
const cheapBands = heights ? mergeBands(sticksFrom(vib.b3lyp.vibrational, heights)) : null;
const lead = mol.anchor_spectrum ? 'anchor' : heights ? 'cheap' : 'positions';
const repo = 'https://github.com/thebreadishard/udacity-capstone-plan/blob/master/plans/05_delta-probed-ir-pipeline/';
const notifyTitle = encodeURIComponent(`Notify me: ${row.name} (${row.id})`);
const notifyBody = encodeURIComponent(`Please notify me when ${row.name} (${row.id}) has a predicted or anchored spectrum.

Page: https://thebreadishard.github.io/spectrum-atlas/molecule/${row.id}/`);
const notifyHref = `https://github.com/thebreadishard/spectrum-atlas/issues/new?title=${notifyTitle}&body=${notifyBody}`;   // phase-1 'notify me' (25 Sep 2026): a GitHub issue the visitor is subscribed to; nothing stored here
---
<Base title={row.name} description={`${row.name} (${row.formula ?? row.smiles}) in the Spectrum Atlas: status, spectrum, frequencies, provenance.`}>
  <nav aria-label="Breadcrumb" class="crumb muted"><a href={withBase('/atlas/')}>Atlas</a> › {row.name}</nav>
  <header class="head">
    <h1>{row.name} <span class="mono muted formula">{row.formula}</span></h1>
    <p class="mono muted ids">{row.id} · SMILES <span>{row.smiles}</span>{row.inchikey && <> · InChIKey <span>{row.inchikey}</span></>}</p>
    <p><span class="chip" data-rung={row.rung}><span class="dot" aria-hidden="true"></span>{labels[row.rung]}</span>
      {describeFlags(row.flags).map((f) => <span class="chip" title={f.title}>{f.text}</span>)}</p>
  </header>

  <div class="cols">
    {lead === 'anchor' && <AnchorSpectrumCard name={row.name} anchor={mol.anchor_spectrum} comparison={mol.comparison} test={mol.test_prediction} validated={row.rung === 5} />}
    {lead === 'cheap' && <CheapSpectrumCard name={row.name} bands={cheapBands} acc={summary.shape_accuracy} lead />}
    {lead === 'positions' && <FrequenciesCard name={row.name} rows={rows} b3lyp={vib.b3lyp.vibrational} wb97x={vib.wb97x.vibrational} hasHeights={false} lead />}
    <aside class="side">
      <section class="card">
        <h2>Structure</h2>
        <figure class="depiction" set:html={svg}></figure>
        <figcaption class="muted small">2D depiction from the SMILES.</figcaption>
        <Viewer3D geometry={mol.geometry} name={row.name} />
      </section>
      <section class="card">
        <h2>Status ladder</h2>
        <ol class="steps">
          {labels.map((l, i) => (
            <li class={reached(i) ? 'on' : 'off'}><span class="mark" aria-hidden="true">{reached(i) ? '●' : '○'}</span> {l}
              {i === 1 && reached(1) && mol.ledger && <span class="muted small"> — {mol.ledger.end.slice(0, 10)}, {mol.ledger.machine}</span>}
              {(i === 4 || i === 5) && reached(i) && row.evidence && <span class="muted small"> — <a href={repo + row.evidence[0]}>evidence</a></span>}
              {(i === 2 || i === 3) && <span class="muted small"> — not yet: the learned layer is training</span>}
            </li>
          ))}
        </ol>
      </section>
      <section class="card">
        <h2>Request a run</h2>
        <p class="muted small">Not available yet: the learned layer is being trained and licensed per mode family. Sign-in will be needed only to request runs; reading stays open.</p>
        <p class="small"><strong>Notify me</strong> when this molecule climbs the ladder: <a href={notifyHref}>open a GitHub issue</a> — you are subscribed to it and we close it with a link when the page changes. No e-mail address is stored by this site.</p>
      </section>
    </aside>

    <div class="mainc">
      {lead === 'anchor' && heights && <CheapSpectrumCard name={row.name} bands={cheapBands} acc={summary.shape_accuracy} />}
      {lead !== 'positions' && <FrequenciesCard name={row.name} rows={rows} b3lyp={vib.b3lyp.vibrational} wb97x={vib.wb97x.vibrational} hasHeights={!!heights} />}
      {mol.second_route && (
        <section class="card">
          <h2>Second route</h2>
          <p class="small">Analytic Hessian (pyscf, grid 99/590) against the corpus finite differences: {Object.entries(mol.second_route).map(([k, v]) => `${k} max |Δω| ${v.max_abs_dfreq_cm.toFixed(0)} cm⁻¹`).join('; ')}.</p>
        </section>
      )}
      <section class="card">
        <h2>Provenance</h2>
        <ul class="small">
          <li>Releases: {row.releases.length ? row.releases.join(', ') : 'none yet'}</li>
          <li>Entered the corpus as: {row.source} (layer {row.layer})</li>
          {row.anchor_level && <li>Coupled-cluster anchor: {row.anchor_level}</li>}
          {mol.anchor_spectrum && <li>Anchor spectrum: Hessian {mol.anchor_spectrum.hessian_source.split('/').pop()}{mol.anchor_spectrum.apt_source && <>, dipole derivatives <a href={repo + mol.anchor_spectrum.apt_source}>{mol.anchor_spectrum.apt_source.split('/').pop()}</a></>}</li>}
          {mol.test_prediction && <li>Network test series: {mol.test_prediction.seeds.map((s) => s.file.split('/').pop()).join(', ')}</li>}
          {mol.ledger && <li>Run: {mol.ledger.machine}, {mol.ledger.start} → {mol.ledger.end}, {Number(mol.ledger.seconds_total).toFixed(0)} s, peak {mol.ledger.peak_rss_gb} GB, deck {mol.ledger.deck}</li>}
          <li>Imaginary modes: B3LYP {mol.n_imaginary.b3lyp}, ωB97X {mol.n_imaginary.wb97x}</li>
          {mol.shape && <li>Cheap-level band heights: dipole derivatives <a href={repo + mol.shape.apt_source}>{mol.shape.apt_source.split('/').pop()}</a>, Hessian {mol.shape.hessian_source.split('/').pop()}</li>}
          <li>Source files: <a href={repo + 'modules/05_support_predictor/corpus/'}>corpus factory</a> · <a href={repo + 'modules/05_support_predictor/corpus/manifest.csv'}>manifest</a></li>
        </ul>
      </section>
    </div>
  </div>
</Base>
<style>
  .crumb { font-size: 0.9rem; margin-bottom: var(--space-3); }
  .head { margin-bottom: var(--space-6); }
  .formula { font-size: 0.7em; margin-left: 8px; }
  .ids span { word-break: break-all; }
  .small { font-size: 0.9rem; }
  /* One column below 1024 px: the lead card (first child) leads, then the side cards, then the rest (10 Oct 2026). The lead card is a component,
     so its class is matched with :global() — a scoped selector would not reach a child component's element. */
  .cols { display: grid; grid-template-columns: 1fr; gap: var(--space-4); align-items: start; }
  @media (min-width: 1024px) {
    .cols { grid-template-columns: minmax(300px, 2fr) 3fr; }
    .cols > .side { grid-column: 1; grid-row: 1 / span 2; }
    .cols > :global(.first) { grid-column: 2; grid-row: 1; }
    .cols > .mainc { grid-column: 2; grid-row: 2; }
  }
  .side, .mainc { display: grid; gap: var(--space-4); }
  .depiction { margin: 0 auto; max-width: 260px; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 6px; }
  .steps .off { color: var(--fg-muted); }
  .steps .mark { color: var(--accent); }
  /* tablets (addendum 27 Sep 2026) */
  @media (min-width: 768px) and (max-width: 1023px) {
    .cols { gap: var(--space-6); }
    .side { grid-template-columns: 1fr 1fr; gap: var(--space-6); align-items: start; }      /* Structure beside the ladder; the request card spans */
    .side > section:nth-child(3) { grid-column: 1 / -1; }
    .depiction { max-width: 300px; }
    .head h1 { font-size: 2rem; }
  }
  @media (min-width: 1024px) and (max-width: 1279px) {
    .cols { gap: var(--space-6); }
    .side { position: sticky; top: 76px; max-height: calc(100dvh - 92px); overflow: auto; }   /* the ladder stays in view while the modes scroll */
  }
  @media (min-width: 768px) and (max-width: 1279px) {
    .steps { gap: 10px; }
    .steps li { min-height: 32px; }
  }
</style>
