---
// Base layout: slim top bar on desktop, bottom navigation on mobile (design §4, §6). Every page passes a title and a one-line description.
import '../styles/tokens.css';
import summary from '../../../export/out/summary.json';
import { withBase, base } from '../lib/base';
const { title, description = 'Infrared spectra of molecules, corrected by a learned layer trained on coupled-cluster anchors — with the status and the provenance of every number.' } = Astro.props;
const nav = [
  { href: withBase('/atlas/'), label: 'Atlas' },
  { href: withBase('/methods/'), label: 'Methods' },
  { href: withBase('/status/'), label: 'Status' },
  { href: withBase('/about/'), label: 'About' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · Spectrum Atlas` : 'Spectrum Atlas'}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⌬</text></svg>" />
  </head>
  <body data-base={base}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <div class="container bar">
        <a class="brand" href={withBase('/')} aria-label="Spectrum Atlas home"><span class="mark" aria-hidden="true">⌬</span> Spectrum Atlas</a>
        <nav class="desktop" aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <form class="search" action={withBase('/atlas/')} method="get" role="search">
          <label class="visually-hidden" for="q">Search molecules</label>
          <input id="q" name="q" type="search" placeholder="naphthalene · C14H10 · c1ccc2ccccc2c1" autocomplete="off" />
        </form>
      </div>
    </header>
    <main id="main" class="container">
      <slot />
    </main>
    <footer class="container foot muted">
      <p>Data as of {summary.built_utc.slice(0, 10)} · releases {summary.releases.join(', ')} · every number links to the file it came from · no trackers, no cookies.</p>
    </footer>
    <nav class="mobile" aria-label="Primary (mobile)">
      {nav.map((n) => <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </body>
</html>
<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--bg-elev); padding: 8px 12px; border-radius: 6px; z-index: 10; }
  .skip:focus { left: 8px; }
  .top { border-bottom: 1px solid var(--line); background: var(--bg-elev); position: sticky; top: 0; z-index: 5; }
  .bar { display: flex; align-items: center; gap: var(--space-4) var(--space-6); min-height: 52px; flex-wrap: wrap; padding-block: 6px; }
  .brand { font-weight: 650; color: var(--fg); text-decoration: none; white-space: nowrap; }
  .mark { color: var(--accent); font-size: 1.2em; }
  nav.desktop { display: flex; gap: var(--space-4); }
  nav.desktop a { color: var(--fg-muted); text-decoration: none; padding: 6px 2px; border-bottom: 2px solid transparent; }
  nav.desktop a[aria-current="page"] { color: var(--fg); border-bottom-color: var(--accent); }
  .search { margin-left: auto; flex: 1 1 260px; max-width: 420px; min-width: 0; }
  .search input { width: 100%; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg); font: inherit; }
  main { padding-block: var(--space-8) var(--space-12); }
  .foot { padding-block: var(--space-6) var(--space-12); font-size: 0.85rem; border-top: 1px solid var(--line); }
  nav.mobile { display: none; }
  @media (max-width: 767px) {
    nav.desktop { display: none; }
    .search { flex: 1 1 auto; }
    main { padding-bottom: 96px; }
    nav.mobile { display: grid; grid-template-columns: repeat(4, 1fr); position: fixed; inset: auto 0 0 0; background: var(--bg-elev); border-top: 1px solid var(--line); padding: 6px 8px calc(6px + env(safe-area-inset-bottom)); z-index: 5; }
    nav.mobile a { text-align: center; padding: 10px 4px; min-height: 44px; color: var(--fg-muted); text-decoration: none; font-size: 0.85rem; border-radius: 8px; }
    nav.mobile a[aria-current="page"] { color: var(--fg); background: var(--accent-soft); }
  }
</style>
