---
// Stick spectrum of band positions rendered at build time as SVG (no client JavaScript): up to four series, wavenumber axis below, micron axis
// above, Okabe–Ito colours, a data-table twin lives next to it on the page (design §4.3, §7). Every stick has unit height: this chart shows
// positions; heights are drawn by IRSpectrum.astro where the molecule has dipole derivatives (TASKS 44).
// 10 Oct 2026: two renders, a wide one and a narrow one for phones, of which CSS shows one — on a 375 px phone the single 720-unit render put its
// labels at 4.7 px (measured on the live benzene page).
interface Series { label: string; values: number[]; color?: string; dashed?: boolean }
const { series, min = 0, max = 3600, height = 220, title = 'Harmonic stick spectrum' } = Astro.props as { series: Series[]; min?: number; max?: number; height?: number; title?: string };
const palette = ['#0072B2', '#E69F00', '#009E73', '#CC79A7'];
// comparisons stay in the frontmatter: a "<=" inside the template is read as a tag by the Astro compiler
const inRange = (vals: number[]) => vals.filter((v) => v >= min && v <= max);
const seriesIn = series.map((s) => ({ ...s, shown: inRange(s.values) }));
const desc = seriesIn.map((s) => `${s.label}: ${s.shown.length} modes between ${min} and ${max} per centimetre`).join('. ') + '.';
function render(W: number, H: number, font: number, tick: number, microns: number[]) {
  const padL = 44, padR = 16, padT = 26, padB = 34;
  const x = (v: number) => padL + (W - padL - padR) * (max - v) / (max - min);   // high wavenumber on the left, as spectroscopists read it
  const ticks = [] as number[];
  for (let t = Math.ceil(min / tick) * tick; t <= max; t += tick) ticks.push(t);
  const lane = (H - padT - padB) / seriesIn.length;
  return { W, H, font, padL, padR, padT, padB, x, ticks, lane, microns: microns.filter((m) => 1e4 / m >= min && 1e4 / m <= max) };
}
const wide = render(620, height, 12.5, 500, [3, 4, 5, 6, 8, 10, 15, 25]);   // ≥ 11 px labels from a 1024 px desktop column to a tablet's full width
const narrow = render(360, height, 13, 1000, [3, 5, 10, 20]);   // ≈ 11 px labels on a 375 px phone
const medium = render(480, height, 12, 500, [3, 4, 5, 6, 8, 10, 15, 25]);   // 10 Oct: a 1024 px desktop's column is 512 px wide
---
<figure class="spectrum">
  {[['wide', wide], ['medium', medium], ['narrow', narrow]].map(([cls, r]) => (
    <svg class={cls} viewBox={`0 0 ${r.W} ${r.H}`} role="img" aria-label={`${title}. ${desc}`} width="100%">
      <g class="axis" font-size={r.font} fill="currentColor">
        {r.ticks.map((t) => <g><line x1={r.x(t)} x2={r.x(t)} y1={r.padT} y2={r.H - r.padB} stroke="currentColor" stroke-opacity="0.12" /><text x={r.x(t)} y={r.H - r.padB + r.font + 4} text-anchor="middle">{t}</text></g>)}
        <text x={(r.padL + r.W - r.padR) / 2} y={r.H - 6} text-anchor="middle">wavenumber (cm⁻¹)</text>
        {r.microns.map((m) => <text x={r.x(1e4 / m)} y={r.padT - 12} text-anchor="middle" fill-opacity="0.7">{m} µm</text>)}
      </g>
      {seriesIn.map((s, i) => (
        <g stroke={s.color ?? palette[i % palette.length]} stroke-width="1.5" stroke-dasharray={s.dashed ? '3 2' : undefined}>
          {s.shown.map((v) => <line x1={r.x(v)} x2={r.x(v)} y1={r.padT + r.lane * (i + 1) - 4} y2={r.padT + r.lane * i + 6} />)}
          <text x={r.padL + 4} y={r.padT + r.lane * i + r.font + 3} font-size={r.font} fill={s.color ?? palette[i % palette.length]} stroke="none">{s.label}</text>
        </g>
      ))}
      <line x1={r.padL} x2={r.W - r.padR} y1={r.H - r.padB} y2={r.H - r.padB} stroke="currentColor" stroke-opacity="0.5" />
    </svg>
  ))}
</figure>
<style>
  .spectrum { margin: 0; color: var(--fg); }
  .spectrum svg { display: block; max-width: 100%; }
  /* the render follows the card's own width, not the screen's (10 Oct 2026): ≥ 11 px labels from a 375 px phone to a 1280 px desktop */
  .spectrum { container-type: inline-size; }
  .spectrum .medium, .spectrum .narrow { display: none; }
  @container (max-width: 600px) { .spectrum .wide { display: none; } .spectrum .medium { display: block; } }
  @container (max-width: 420px) { .spectrum .medium { display: none; } .spectrum .narrow { display: block; } }
</style>
