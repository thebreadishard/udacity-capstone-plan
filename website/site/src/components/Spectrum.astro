---
// Stick spectrum rendered at build time as SVG (no client JavaScript): up to four series, wavenumber axis below, micron axis above,
// Okabe–Ito colours, a data-table twin lives next to it on the page (design §4.3, §7). Intensities are not in the export yet, so every
// stick has unit height; the prop `heights` (per series) will carry intensities when they exist.
interface Series { label: string; values: number[]; color?: string; dashed?: boolean }
const { series, min = 0, max = 3600, height = 220, title = 'Harmonic stick spectrum' } = Astro.props as { series: Series[]; min?: number; max?: number; height?: number; title?: string };
const palette = ['#0072B2', '#E69F00', '#009E73', '#CC79A7'];
const W = 720, H = height, padL = 44, padR = 16, padT = 26, padB = 34;
const x = (v: number) => padL + (W - padL - padR) * (max - v) / (max - min);   // high wavenumber on the left, as spectroscopists read it
const ticks = [] as number[];
for (let t = Math.ceil(min / 500) * 500; t <= max; t += 500) ticks.push(t);
const microns = [3, 4, 5, 6, 7, 8, 10, 12, 15, 20, 25];
const n = series.length; const lane = (H - padT - padB) / n;
// comparisons stay in the frontmatter: a "<=" inside the template is read as a tag by the Astro compiler
const micronTicks = microns.filter((m) => 1e4 / m >= min && 1e4 / m <= max);
const inRange = (vals: number[]) => vals.filter((v) => v >= min && v <= max);
const seriesIn = series.map((s) => ({ ...s, shown: inRange(s.values) }));
---
<figure class="spectrum">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="sp-title sp-desc" width="100%">
    <title id="sp-title">{title}</title>
    <desc id="sp-desc">{seriesIn.map((s) => `${s.label}: ${s.shown.length} modes between ${min} and ${max} per centimetre`).join('. ')}.</desc>
    <g class="axis" font-size="11" fill="currentColor">
      {ticks.map((t) => <g><line x1={x(t)} x2={x(t)} y1={padT} y2={H - padB} stroke="currentColor" stroke-opacity="0.12" /><text x={x(t)} y={H - padB + 16} text-anchor="middle">{t}</text></g>)}
      <text x={(padL + W - padR) / 2} y={H - 6} text-anchor="middle" font-size="11">wavenumber (cm⁻¹)</text>
      {micronTicks.map((m) => <text x={x(1e4 / m)} y={padT - 12} text-anchor="middle" fill-opacity="0.7">{m} µm</text>)}
    </g>
    {seriesIn.map((s, i) => (
      <g stroke={s.color ?? palette[i % palette.length]} stroke-width="1.5" stroke-dasharray={s.dashed ? '3 2' : undefined}>
        {s.shown.map((v) => <line x1={x(v)} x2={x(v)} y1={padT + lane * (i + 1) - 4} y2={padT + lane * i + 6} />)}
        <text x={padL + 4} y={padT + lane * i + 14} font-size="11" fill={s.color ?? palette[i % palette.length]} stroke="none">{s.label}</text>
      </g>
    ))}
    <line x1={padL} x2={W - padR} y1={H - padB} y2={H - padB} stroke="currentColor" stroke-opacity="0.5" />
  </svg>
</figure>
<style>
  .spectrum { margin: 0; color: var(--fg); }
  .spectrum svg { display: block; max-width: 100%; }
</style>
