---
// 3D viewer island (design §4.3, §6): nothing loads until the visitor taps "Show 3D"; then 3Dmol.js is imported on demand and the corpus
// geometry (bohr → Å) is shown as sticks. The 2D depiction remains the accessible representation; the canvas is aria-hidden.
const { geometry, name } = Astro.props as { geometry: { symbols: string[]; coords_bohr: number[][] }; name: string };
const BOHR = 0.529177210903;
const xyz = `${geometry.symbols.length}\n${name}\n` + geometry.symbols.map((s, i) => `${s} ${geometry.coords_bohr[i].map((c) => (c * BOHR).toFixed(6)).join(' ')}`).join('\n');
---
<div class="viewer3d" data-xyz={xyz}>
  <button type="button" class="show3d">Show 3D <span class="muted">(loads a 3D viewer, ≈ 400 kB)</span></button>
  <div class="stage" aria-hidden="true" hidden></div>
  <p class="muted small hint" hidden>Drag to rotate, scroll to zoom. Corpus geometry, B3LYP/6-31G*.</p>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.viewer3d').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('.show3d')!;
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const hint = root.querySelector<HTMLElement>('.hint')!;
    btn.addEventListener('click', async () => {
      btn.disabled = true; btn.textContent = 'Loading…';
      try {
        const mod: any = await import('3dmol');
        const $3Dmol = mod.default ?? mod;
        stage.hidden = false; hint.hidden = false;
        const dark = matchMedia('(prefers-color-scheme: dark)').matches && document.documentElement.dataset.theme !== 'light';
        const viewer = $3Dmol.createViewer(stage, { backgroundColor: dark ? '#1b1d24' : '#ffffff', antialias: true });
        viewer.addModel(root.dataset.xyz, 'xyz');
        viewer.setStyle({}, { stick: { radius: 0.16 }, sphere: { scale: 0.22 } });
        viewer.zoomTo(); viewer.render();
        btn.remove();
      } catch (e) {
        btn.disabled = false; btn.textContent = '3D viewer failed to load — the 2D structure above stands';
      }
    });
  });
</script>
<style>
  .viewer3d { margin-top: var(--space-3); }
  .show3d { font: inherit; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg); cursor: pointer; min-height: 44px; }
  .show3d:hover { border-color: var(--accent); }
  .stage { position: relative; width: 100%; aspect-ratio: 1; max-width: 320px; margin: var(--space-2) auto 0; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .small { font-size: 0.85rem; }
</style>
