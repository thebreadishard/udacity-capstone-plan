---
// The cheap level's infrared spectrum with band heights (TASKS 44), labelled as the pipeline's input, with the measured accuracy of the carried
// network's corrected shape on both hold-outs and the licence (decision 65); the corrected spectrum itself is the pipeline's, not drawn here. Leads the page unless an anchor exists (TASKS 45);
// under an anchor its curve is the anchor card's lower panel (design §10), so this card keeps only the words and the accuracy table (chart={false}).
import IRSpectrum from './IRSpectrum.astro';
import type { Band } from '../lib/bands';
const { name, bands, acc, licence, networks = null, levelName = '', nAtoms = 0, lead = false, chart = true } =
  Astro.props as { name: string; bands: Band[]; acc: any; licence?: any; networks?: any; levelName?: string; nAtoms?: number; lead?: boolean; chart?: boolean };
// Reader text says 'test set' for the hold-outs (the user, 17 Nov 2026, TASKS 261); the export keeps the keys a and b.
const holdoutLabel: Record<string, string> = { a: 'test set (a): unseen simple aromatics (layer A)', b: 'test set (b): molecules of held-out scaffolds' };
const families: string[] = acc ? Object.keys(acc.holdouts.a.product) : [];
const licensed: string[] = licence ? licence.licensed_families : [];
const line: number = licence ? licence.line_cm : 0;
const molecules = (p: any) => p.n_molecules_with_modes === p.n_molecules ? `${p.n_molecules} molecules` : `${p.n_molecules_with_modes} of ${p.n_molecules} molecules`;
const fmt = (x: number) => x.toFixed(2);
const pool: number[] | null = networks ? networks.pool_atoms : null;
const outsidePool = !!pool && nAtoms > 0 && (nAtoms < pool[0] || nAtoms > pool[1]);
const twice: number = networks && networks.distinct_entries !== null ? networks.trained_on_entries - networks.distinct_entries : 0;
const heightsNote = 'Band heights from the molecule\'s dipole derivatives and the same B3LYP Hessian as the listed positions (double harmonic).';
---
<section class:list={['card', { first: lead }]}>
  <h2>Infrared spectrum at the cheap level <span class="muted small">(B3LYP/6-31G*, the pipeline's input)</span></h2>
  {chart
    ? <IRSpectrum bands={bands} title={`Infrared spectrum of ${name} at the cheap level (B3LYP)`} leadLabel="cheap input (B3LYP)">
        <p class="muted">{heightsNote}</p>
      </IRSpectrum>
    : <p class="muted small">Drawn as the lower panel of the anchor spectrum above. {heightsNote}</p>}
  <p class="muted small"><strong>Predicted spectrum</strong> (rung 3, the learned correction): computed by the pipeline, not drawn on this page{licensed.length > 0 && `; licensed for ${licensed.join(', ')} against ${levelName}, the DFT stand-in — not coupled cluster or experiment (decision 65)`}.</p>
  {outsidePool && <p class="small"><strong>Size caveat:</strong> {name} has {nAtoms} atoms; the networks were trained on molecules of {pool![0]}–{pool![1]} atoms, and the errors and the licence below were measured inside that range, so they may not hold for this molecule.</p>}
  {acc && (
    <details class="acc" open>
      <summary>How well is this spectrum known?</summary>
      <p class="small">{networks && networks.kind === 'release'
        ? `The spectra the pipeline prints come from the release networks of ΔH network v${acc.version}, trained on all ${networks.trained_on_entries} labelled entries of the training pool (an entry is one corpus row: a labelled molecule in one charge state${twice ? `; ${twice} molecules appear in two layers` : ''}), test sets (a) and (b) included: ${networks.fitting}. Every error and the licence below were measured on the measurement networks of the same version (${networks.measurement_networks} networks): the same recipe trained without the molecules of test sets (a) and (b), on molecules those networks never saw.`
        : `The spectra the pipeline prints and every error below come from the measurement networks of ΔH network v${acc.version}, measured on molecules they never saw.`}</p>
      <table class="lic">
        <thead><tr><th>mode family</th><th class="num">test set (a)</th><th class="num">test set (b)</th><th>licensed</th></tr></thead>
        <tbody>
          {families.map((f) => (
            <tr><td>{f}</td>{(['a', 'b'] as const).map((h) => {
              const p = acc.holdouts[h].product[f];
              return <td class="num" title={`95 % interval ${fmt(p.interval[0])}–${fmt(p.interval[1])} cm⁻¹ over ${p.n_molecules_with_modes} of ${p.n_molecules} molecules`}>{fmt(p.rms)}{p.interval_crosses_line ? ' †' : ''}<br /><span class="muted">{molecules(p)}</span></td>;
            })}<td>{licensed.includes(f) ? 'yes' : 'no'}</td></tr>
          ))}
        </tbody>
      </table>
      <p class="muted small">Licence: error of the corrected band positions (cm⁻¹, rms over the family's bands, seed-mean correction) on molecules
        the measurement networks never saw, against {levelName} — the DFT stand-in for the higher level, not against coupled cluster and not against
        experiment. A family is licensed when its error is at most {line} cm⁻¹ on both test sets (decision 65). Under each error: how many of the test
        set's molecules have bands of that family. † the 95 % interval of a bootstrap over molecules reaches above {line} cm⁻¹ (hover for the interval).</p>
      <table>
        <thead><tr><th>shape measured on (ΔH network v{acc.version}, measurement networks)</th><th class="num">spectrum overlap<br />cheap → corrected</th><th class="num">height error<br />cheap → corrected</th></tr></thead>
        <tbody>
          {Object.entries(acc.holdouts).map(([h, v]: [string, any]) => (
            <tr><td>{holdoutLabel[h]} ({v.shape.n_molecules} molecules with band heights), DFT stand-in for the higher level</td><td class="num">{v.shape.cheap.spectrum_overlap.toFixed(2)} → {v.shape.corrected.spectrum_overlap.toFixed(2)}</td><td class="num">{v.shape.cheap.intensity_error.toFixed(2)} → {v.shape.corrected.intensity_error.toFixed(2)}</td></tr>
          ))}
          <tr><td>against coupled cluster</td><td class="num" colspan="2">not measured for this version</td></tr>
        </tbody>
      </table>
      <p class="muted small">Overlap: similarity of the two broadened spectra (1 = the same shape). Height error: relative error per band, weighted by
        height (0 = the same heights). "Corrected" is the learned correction on molecules it never saw; the pipeline serves it for the licensed families. Open: the dipole derivatives
        themselves are computed at the cheap level (on benzene they differ from coupled cluster by about 20 %).</p>
    </details>
  )}
</section>
<style>
  .small { font-size: 0.9rem; }
  .acc { margin-top: var(--space-3); }
  .acc summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .acc table { width: 100%; font-size: 0.9rem; }
  .acc .lic { margin-bottom: var(--space-2); }
</style>
