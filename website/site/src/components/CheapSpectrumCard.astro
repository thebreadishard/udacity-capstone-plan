---
// The cheap level's infrared spectrum with band heights (TASKS 44), labelled as the pipeline's input, with the measured accuracy of the carried
// network's corrected shape on both hold-outs and the licence (decision 65); the corrected spectrum itself is the pipeline's, not drawn here. Leads the page unless an anchor exists (TASKS 45);
// under an anchor its curve is the anchor card's lower panel (design §10), so this card keeps only the words and the accuracy table (chart={false}).
import IRSpectrum from './IRSpectrum.astro';
import type { Band } from '../lib/bands';
const { name, bands, acc, licence, lead = false, chart = true } = Astro.props as { name: string; bands: Band[]; acc: any; licence?: any; lead?: boolean; chart?: boolean };
const holdoutLabel: Record<string, string> = { a: 'unseen simple aromatics (layer A)', b: 'molecules of unseen scaffolds' };
const heightsNote = 'Band heights from the molecule\'s dipole derivatives and the same B3LYP Hessian as the listed positions (double harmonic).';
---
<section class:list={['card', { first: lead }]}>
  <h2>Infrared spectrum at the cheap level <span class="muted small">(B3LYP/6-31G*, the pipeline's input)</span></h2>
  {chart
    ? <IRSpectrum bands={bands} title={`Infrared spectrum of ${name} at the cheap level (B3LYP)`} leadLabel="cheap input (B3LYP)">
        <p class="muted">{heightsNote}</p>
      </IRSpectrum>
    : <p class="muted small">Drawn as the lower panel of the anchor spectrum above. {heightsNote}</p>}
  <p class="muted small"><strong>Predicted spectrum</strong> (rung 3, the learned correction): computed by the pipeline, not drawn on this page{licence && licence.licensed_families.length > 0 && `; licensed for ${licence.licensed_families.join(', ')} (decision 65)`}.</p>
  {acc && (
    <details class="acc" open>
      <summary>How well is this shape known?</summary>
      <table>
        <thead><tr><th>measured on (ΔH network v{acc.version})</th><th class="num">spectrum overlap<br />cheap → corrected</th><th class="num">height error<br />cheap → corrected</th></tr></thead>
        <tbody>
          {Object.entries(acc.holdouts).map(([h, v]: [string, any]) => (
            <tr><td>{v.shape.n_molecules} {holdoutLabel[h]}, DFT stand-in for the higher level</td><td class="num">{v.shape.cheap.spectrum_overlap.toFixed(2)} → {v.shape.corrected.spectrum_overlap.toFixed(2)}</td><td class="num">{v.shape.cheap.intensity_error.toFixed(2)} → {v.shape.corrected.intensity_error.toFixed(2)}</td></tr>
          ))}
          <tr><td>against coupled cluster</td><td class="num" colspan="2">not measured for this version</td></tr>
        </tbody>
      </table>
      <p class="muted small">Overlap: similarity of the two broadened spectra (1 = the same shape). Height error: relative error per band, weighted by
        height (0 = the same heights). "Corrected" is the learned correction on molecules it never saw; the pipeline serves it for the licensed families. Open: the dipole derivatives
        themselves are computed at the cheap level (on benzene they differ from coupled cluster by about 20 %).</p>
    </details>
  )}
</section>
<style>
  .small { font-size: 0.9rem; }
  .acc { margin-top: var(--space-3); }
  .acc summary { cursor: pointer; font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .acc table { width: 100%; font-size: 0.9rem; }
</style>
