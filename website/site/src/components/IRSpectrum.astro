---
// Infrared spectrum with band heights (TASKS 44, design DESIGN_2026-10-10_Intensity_Chart.md §4–4a): Lorentzian-broadened curve (FWHM 10 cm⁻¹, the
// read-out the project measures its accuracy with) and the sticks under it, drawn at their Lorentzian peak so stick and curve share one axis.
// Static SVG at build time, two renders — a wide one (desktop, tablets) and a narrow one (phones, labels ≈ 12 px) — of which CSS shows one.
// Degenerate partners arrive merged (the page sums bands within 1 cm⁻¹); IR-inactive bands (height 0) are not drawn.
interface Band { omega: number; km: number }
const { bands, title, min = 500, max = 3500 } = Astro.props as { bands: Band[]; title: string; min?: number; max?: number };
const HWHM = 5;
const peak = (km: number) => km / (Math.PI * HWHM);                          // a Lorentzian's height at its centre, per cm⁻¹
const shown = bands.filter((b) => b.km > 0 && b.omega >= min && b.omega <= max);
const curveAt = (w: number) => shown.reduce((s, b) => s + (b.km / Math.PI) * HWHM / ((w - b.omega) ** 2 + HWHM ** 2), 0);
const yMax = Math.max(1e-9, ...shown.map((b) => peak(b.km))) * 1.08;
function nice(v: number) { const p = 10 ** Math.floor(Math.log10(v)); const m = v / p; return (m >= 5 ? 5 : m >= 2 ? 2 : 1) * p; }
const yStep = nice(yMax / 3);
const yTicks = [] as number[];
for (let t = 0; t <= yMax; t += yStep) yTicks.push(t);
function render(W: number, H: number, font: number, tick: number, microns: number[]) {
  const padL = 46, padR = 12, padT = 26, padB = 34;
  const x = (v: number) => padL + (W - padL - padR) * (max - v) / (max - min);   // high wavenumber on the left, as spectroscopists read it
  const y = (v: number) => H - padB - (H - padT - padB) * v / yMax;
  const ticks = [] as number[];
  for (let t = Math.ceil(min / tick) * tick; t <= max; t += tick) ticks.push(t);
  const step = (max - min) / ((W - padL - padR) * 2);                         // two samples per pixel of the plot area
  const ws = [] as number[];                                                  // the grid plus every band centre, so each peak reaches its stick
  for (let w = max; w >= min; w -= step) ws.push(w);
  ws.push(...shown.map((b) => b.omega));
  ws.sort((a, b) => b - a);
  const d = ws.map((w, k) => `${k ? 'L' : 'M'}${x(w).toFixed(1)} ${y(curveAt(w)).toFixed(1)}`).join('');
  return { W, H, font, padL, padR, padT, padB, x, y, ticks, d, microns: microns.filter((m) => 1e4 / m >= min + 0.04 * (max - min) && 1e4 / m <= max) };   // no label cut at the right edge
}
const wide = render(620, 250, 12.5, 500, [3, 4, 5, 6, 8, 10, 15, 20]);   // ≥ 11 px labels from a 1024 px desktop column to a tablet's full width
const narrow = render(360, 240, 13, 1000, [3, 5, 10, 20]);   // ≈ 11 px labels at a 375 px phone's card width
const medium = render(480, 240, 12, 500, [3, 4, 5, 6, 8, 10, 15, 20]);   // 10 Oct: a 1024 px desktop's column is 512 px wide
const strongest = shown.reduce((a, b) => (b.km > a.km ? b : a), shown[0] ?? { omega: 0, km: 0 });
const summaryLine = shown.length
  ? `${shown.length} infrared-active bands (${min}–${max} cm⁻¹); the strongest at ${strongest.omega.toFixed(0)} cm⁻¹ (${(1e4 / strongest.omega).toFixed(1)} µm), ${strongest.km.toFixed(0)} km/mol.`
  : `No infrared-active bands between ${min} and ${max} cm⁻¹.`;
const desc = shown.length
  ? `${shown.length} infrared-active bands between ${min} and ${max} per centimetre; the strongest at ${strongest.omega.toFixed(0)} per centimetre (${(1e4 / strongest.omega).toFixed(1)} micrometre), ${strongest.km.toFixed(0)} kilometres per mole.`
  : 'No infrared-active bands in this window.';
---
<figure class="irspec">
  {[['wide', wide], ['medium', medium], ['narrow', narrow]].map(([cls, r]) => (
    <svg class={cls} viewBox={`0 0 ${r.W} ${r.H}`} role="img" aria-label={`${title}. ${desc}`} width="100%">
      <g font-size={r.font} fill="currentColor">
        {r.ticks.map((t) => <g><line x1={r.x(t)} x2={r.x(t)} y1={r.padT} y2={r.H - r.padB} stroke="currentColor" stroke-opacity="0.12" /><text x={r.x(t)} y={r.H - r.padB + r.font + 4} text-anchor="middle">{t}</text></g>)}
        {r.microns.map((m) => <text x={r.x(1e4 / m)} y={r.padT - 10} text-anchor="middle" fill-opacity="0.7">{m} µm</text>)}
        {yTicks.map((t) => <g><line x1={r.padL} x2={r.W - r.padR} y1={r.y(t)} y2={r.y(t)} stroke="currentColor" stroke-opacity="0.08" /><text x={r.padL - 4} y={r.y(t) + 4} text-anchor="end">{t >= 10 ? t.toFixed(0) : t.toFixed(1)}</text></g>)}
        <text x={(r.padL + r.W - r.padR) / 2} y={r.H - 4} text-anchor="middle">wavenumber (cm⁻¹)</text>
      </g>
      <g stroke="#D55E00" stroke-width="1.2">
        {shown.map((b) => <line x1={r.x(b.omega)} x2={r.x(b.omega)} y1={r.y(0)} y2={r.y(peak(b.km))} />)}
      </g>
      <path d={r.d} fill="none" stroke="#0072B2" stroke-width="1.6" />
      <line x1={r.padL} x2={r.W - r.padR} y1={r.H - r.padB} y2={r.H - r.padB} stroke="currentColor" stroke-opacity="0.5" />
    </svg>
  ))}
  <figcaption class="small">{summaryLine} <span class="muted">Curve: Lorentzian, FWHM 10 cm⁻¹ (blue); sticks: band heights at the curve's peak scale (orange); axis in km mol⁻¹ per cm⁻¹.</span></figcaption>
</figure>
<style>
  .irspec { margin: 0; color: var(--fg); }
  .irspec svg { display: block; max-width: 100%; }
  /* the render follows the card's own width, not the screen's (10 Oct 2026): ≥ 11 px labels from a 375 px phone to a 1280 px desktop */
  .irspec { container-type: inline-size; }
  .irspec .medium, .irspec .narrow { display: none; }
  @container (max-width: 600px) { .irspec .wide { display: none; } .irspec .medium { display: block; } }
  @container (max-width: 420px) { .irspec .medium { display: none; } .irspec .narrow { display: block; } }
  .small { font-size: 0.9rem; }
</style>
