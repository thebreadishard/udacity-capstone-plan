---
// The anchor's spectrum (TASKS 45, design §9): the best spectrum the page has, so it leads. Positions and mode shapes from the carried anchor
// Hessian; heights from the anchor's own CC dipole derivatives, else the B3LYP ones (said), else positions only. The cheap Hessian is drawn with the
// same dipole derivatives so the two curves differ only by the Hessian; the network's leave-one-out prediction is a labelled test series.
// Design §10 (10 Oct 2026): the cheap input (B3LYP Hessian and dipole derivatives) is the lower panel on the same axis, so a landscape tablet shows
// both spectra in the first screen; the card shows one key line and keeps the reading notes behind a tap.
import IRSpectrum from './IRSpectrum.astro';
import Spectrum from './Spectrum.astro';
import { mergeBands, type Band } from '../lib/bands';
// A positions-only anchor draws the cheap level's two functionals in its own chart (wb97x), so the frequencies card below is only the table.
const { name, anchor, comparison, test, cheap = null, wb97x = [], validated = false } =
  Astro.props as { name: string; anchor: any; comparison: any; test: any; cheap?: Band[] | null; wb97x?: number[]; validated?: boolean };
const analytic = comparison.cheap.hessian_source.endsWith('_analytic.npz');
const hasHeights = anchor.kind === 'positions and heights';
const rung = validated ? 'rung 5, validated' : 'rung 4, anchored';                 // short, so the heading takes one line on a landscape tablet
const rungNote = validated ? 'Rung 5: the anchor is validated against laboratory bands.' : 'Rung 4: anchored at the coupled-cluster level.';
const aptNote = !hasHeights ? 'Band heights: not computed for this molecule yet (no dipole derivatives); positions only.'
  : anchor.apt_level.startsWith('CCSD(T)') ? 'Band heights from the anchor\'s own coupled-cluster dipole derivatives.'
  : 'Band heights from cheap-level (B3LYP) dipole derivatives: the positions and mode shapes are the anchor\'s, the dipole derivatives are not.';
const cmpLine = `Compared with the cheap Hessian (B3LYP${analytic ? ', analytic' : ''}${hasHeights ? ', the same dipole derivatives' : ''}): `
  + (comparison.spectrum_overlap != null ? `spectrum overlap ${comparison.spectrum_overlap.toFixed(2)}, ` : '')
  + `frequency rms ${comparison.freq_rms_cm.toFixed(1)} cm⁻¹.`;
const testBands = test ? test.seeds.map((s) => mergeBands(s.sticks)) : [];
const overlaps = [test && `network, held-out test ${test.spectrum_overlap_mean.toFixed(2)} (${test.spectrum_overlap_range[0].toFixed(2)}–${test.spectrum_overlap_range[1].toFixed(2)})`,
                  comparison.spectrum_overlap != null && `cheap Hessian ${comparison.spectrum_overlap.toFixed(2)}`].filter(Boolean);
---
<section class="card first">
  <h2>Infrared spectrum at the anchor level <span class="muted small">({anchor.level}; {rung})</span></h2>
  {hasHeights
    ? <IRSpectrum bands={mergeBands(anchor.sticks)} compare={mergeBands(comparison.cheap.sticks)} test={testBands} below={cheap ?? []}
        title={`Infrared spectrum of ${name} at the anchor level${cheap ? ', with the cheap input below' : ''}`}
        leadLabel="anchor" compareLabel="cheap Hessian" testLabel="network (held-out test)" belowLabel="cheap input (B3LYP)">
        {overlaps.length > 0 && <p slot="key" class="small key">Spectrum overlap with the anchor (1 = the same shape): {overlaps.join(' · ')}.</p>}
        <p class="muted">{rungNote} {aptNote} {cmpLine}{cheap ? ' The lower panel is the pipeline\'s input: the B3LYP Hessian with its own B3LYP dipole derivatives.' : ''}</p>
        {test && (
          <p><strong>The network's prediction, shown as a test.</strong> The Atlas does not yet give the network's predictions as its answer (that is
            rung 3, which waits until a mode family is licensed). This one is shown because this anchor was left out when the network was tuned to the
            coupled-cluster anchors (T3, the carried model's three seeds), so the green band shows how the network does on a molecule it did not see at this level:
            spectrum overlap with the anchor {test.spectrum_overlap_mean.toFixed(2)} ({test.spectrum_overlap_range[0].toFixed(2)}–{test.spectrum_overlap_range[1].toFixed(2)}
            over the seeds){comparison.spectrum_overlap != null ? `, against ${comparison.spectrum_overlap.toFixed(2)} for the cheap Hessian` : ''}.</p>
        )}
      </IRSpectrum>
    : <>
        <Spectrum title={`Positions of ${name}: anchor and cheap level`} height={250}
          series={[{ label: 'anchor', values: anchor.sticks.map((s) => s.omega_cm) }, { label: 'B3LYP', values: comparison.cheap.sticks.map((s) => s.omega_cm), dashed: true },
                   ...(wb97x.length ? [{ label: 'ωB97X', values: wb97x }] : [])]} />
        <p class="muted small">{aptNote} {cmpLine}</p>
      </>}
</section>
<style>
  .small { font-size: 0.9rem; }
  .key { margin: var(--space-2) 0 0; }
</style>
