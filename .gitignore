.env
.venv/

scraper/udacity_session/
scraper/*.json
scraper/*.html

udacity_session/
*.json
*.html

__pycache__/
*.pyc

# Psi4 scratch and run logs; the .json results ARE committed
plans/*/probes/results_dft_locality/*.log
plans/*/probes/results_dft_locality/run_log.txt
plans/*/probes/psi4_benchmark.log
timer.dat
psi.*.clean
*.molden

# The probe results ARE the measurement, so they override the blanket *.json rule
!plans/*/probes/results_dft_locality/*.json
plans/*/probes/results_dft_locality/run_log*.txt
plans/*/probes/results_dft_locality/*.npz
plans/*/probes/batch_results/*.npz
plans/*/probes/batch_results/*.log
!plans/*/probes/batch_results/*.json

# The queue carries the pre-registered reason for every job. A criterion that is not
# in version control is not pre-registered.
!plans/*/probes/jobs.json
plans/*/probes/*.log

# Plan 05: the probe results are the measurement (JSON, npz, logs, reports); psi4 scratch output is not
!plans/*/probes/results_*/**/*.json
!plans/*/probes/results_*/*.json
plans/*/probes/results_*/**/psi4.out
plans/*/probes/results_*/psi4.out

# local literature copies (open-access downloads; the repo holds references only)
Papers/

# Plan 05 modules: raw downloads (PAHdb XML, Zenodo archives) and the large derived band tables stay out of git; species tables, summaries and reports are committed
plans/*/modules/*/data/*
!plans/*/modules/*/data/_synthetic_test.xml
plans/*/modules/*/out/**/*.csv.gz
