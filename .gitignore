.env
.venv/

scraper/udacity_session/
scraper/*.json
scraper/*.html

udacity_session/
*.json
*.html

__pycache__/
*.pyc

# Psi4 scratch and run logs; the .json results ARE committed
plans/*/probes/results_dft_locality/*.log
plans/*/probes/results_dft_locality/run_log.txt
plans/*/probes/psi4_benchmark.log
timer.dat
psi.*.clean
*.molden

# The probe results ARE the measurement, so they override the blanket *.json rule
!plans/*/probes/results_dft_locality/*.json
plans/*/probes/results_dft_locality/run_log*.txt
